rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{teamId}/{fileName} {
      allow read: if request.auth != null
        && (
          request.auth.token.role == 'ADMIN'
          || firestore.get(/databases/(default)/documents/teams/$(teamId)).data.leaderId == request.auth.uid
          || request.auth.uid in firestore.get(/databases/(default)/documents/teams/$(teamId)).data.memberUids
        );
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
